# Google OAuth client ID + secret (from Google Cloud Console > APIs &
# Services > Credentials). Required — the server uses these for the OAuth
# code flow that signs users in AND authorizes access to their own Drive
# to create/use their CRM spreadsheet.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Secret used to sign this app's own session JWTs (not related to Google)
SESSION_SECRET=change-me-to-a-long-random-string

# Key used to encrypt the Google refresh token embedded in each session
# JWT. The server keeps no database, so this is the only place a user's
# refresh token is stored — encrypting it means a leaked/logged JWT alone
# doesn't hand over standing access to the user's Sheets/Drive.
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Origin the client is served from (for CORS + cookie settings)
CLIENT_ORIGIN=http://localhost:5173

# Origin this server is reachable at — used to build the Google OAuth
# redirect URI (must be registered as an Authorized redirect URI in
# Google Cloud Console as `${SERVER_ORIGIN}/api/auth/google/callback`)
SERVER_ORIGIN=http://localhost:3001

PORT=3001
NODE_ENV=development
