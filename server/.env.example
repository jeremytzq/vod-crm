# Google OAuth client ID (from Google Cloud Console > APIs & Services > Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client secret for the same OAuth client. Only used for the redirect-based
# fallback sign-in flow (/api/auth/google/redirect) — required if you want
# that fallback to work, optional if you're fine relying solely on the
# Google Identity Services button.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Secret used to sign this app's own session JWTs (not related to Google)
SESSION_SECRET=change-me-to-a-long-random-string

# Origin the client is served from (for CORS + cookie settings)
CLIENT_ORIGIN=http://localhost:5173

# Origin this server is reachable at — used to build the Google OAuth
# redirect URI (must be registered as an Authorized redirect URI in
# Google Cloud Console as `${SERVER_ORIGIN}/api/auth/google/callback`)
SERVER_ORIGIN=http://localhost:3001

PORT=3001
NODE_ENV=development
