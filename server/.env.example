# Google OAuth client ID (from Google Cloud Console > APIs & Services > Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Secret used to sign this app's own session JWTs (not related to Google)
SESSION_SECRET=change-me-to-a-long-random-string

# Origin the client is served from (for CORS + cookie settings)
CLIENT_ORIGIN=http://localhost:5173

PORT=3001
NODE_ENV=development
